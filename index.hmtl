<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Website Build | Client Intake Form</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&display=swap" rel="stylesheet">
<style>
:root {
  --navy: #0F172A;
  --navy-800: #1E293B;
  --slate-600: #475569;
  --slate-500: #64748B;
  --slate-400: #94A3B8;
  --slate-300: #CBD5E1;
  --slate-200: #E2E8F0;
  --slate-100: #F1F5F9;
  --slate-50: #F8FAFC;
  --emerald-600: #059669;
  --emerald-500: #10B981;
  --emerald-400: #34D399;
  --emerald-100: #D1FAE5;
  --emerald-50: #ECFDF5;
  --amber-500: #F59E0B;
  --amber-50: #FFFBEB;
  --red-500: #EF4444;
  --red-50: #FEF2F2;
  --white: #FFFFFF;
  --font-display: 'Fraunces', serif;
  --font-body: 'DM Sans', sans-serif;
  --shadow-sm: 0 1px 3px rgba(15,23,42,.06);
  --shadow-md: 0 4px 16px rgba(15,23,42,.08);
  --shadow-lg: 0 8px 32px rgba(15,23,42,.10);
  --radius: 14px;
  --radius-sm: 10px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
body{font-family:var(--font-body);color:var(--navy);background:var(--slate-50);line-height:1.6;min-height:100vh}

/* Layout */
.app-shell{display:grid;grid-template-columns:280px 1fr;min-height:100vh}
@media(max-width:900px){.app-shell{grid-template-columns:1fr}}

/* Sidebar */
.sidebar{background:var(--navy);color:white;padding:32px 0;position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column}
@media(max-width:900px){.sidebar{position:fixed;left:-320px;width:300px;z-index:100;transition:left .3s cubic-bezier(.22,1,.36,1);box-shadow:4px 0 24px rgba(0,0,0,.3)}.sidebar.open{left:0}}
.sidebar-brand{padding:0 24px 28px;border-bottom:1px solid rgba(255,255,255,.08)}
.sidebar-brand h1{font-family:var(--font-display);font-size:1.15rem;font-weight:700;margin-bottom:4px}
.sidebar-brand p{font-size:.75rem;color:var(--slate-400);line-height:1.5}
.sidebar-nav{flex:1;padding:20px 0}
.nav-section-label{padding:0 24px;font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:var(--slate-500);margin:16px 0 8px}
.nav-item{display:flex;align-items:center;gap:12px;padding:10px 24px;font-size:.82rem;font-weight:500;color:var(--slate-400);cursor:pointer;transition:all .2s;position:relative;border:none;background:none;width:100%;text-align:left;font-family:var(--font-body)}
.nav-item::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--emerald-500);border-radius:0 2px 2px 0;opacity:0;transition:opacity .2s}
.nav-item:hover{color:white;background:rgba(255,255,255,.04)}
.nav-item.active{color:white;background:rgba(16,185,129,.08)}.nav-item.active::before{opacity:1}
.nav-item.completed .nav-check{background:var(--emerald-500);border-color:var(--emerald-500)}
.nav-item.completed .nav-check::after{content:'';display:block;width:5px;height:8px;border:solid white;border-width:0 2px 2px 0;transform:rotate(45deg);margin:-1px 0 0 1px}
.nav-check{width:18px;height:18px;border-radius:5px;border:1.5px solid var(--slate-500);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s}
.nav-item.active .nav-check{border-color:var(--emerald-500)}
.sidebar-progress{padding:20px 24px;border-top:1px solid rgba(255,255,255,.08)}
.progress-label{display:flex;justify-content:space-between;font-size:.75rem;color:var(--slate-400);margin-bottom:8px}
.progress-bar{height:6px;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--emerald-600),var(--emerald-400));border-radius:99px;transition:width .4s cubic-bezier(.22,1,.36,1)}

/* Mobile toggle */
.mob-bar{display:none;position:fixed;top:0;left:0;right:0;z-index:90;background:var(--navy);padding:14px 20px;align-items:center;justify-content:space-between}
@media(max-width:900px){.mob-bar{display:flex}}
.mob-bar h2{font-family:var(--font-display);color:white;font-size:1rem}
.mob-btn{background:none;border:none;color:white;padding:4px;cursor:pointer}
.mob-btn svg{width:24px;height:24px}
.mob-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:99}
.mob-overlay.open{display:block}

/* Main content */
.main{padding:40px;max-width:820px;margin:0 auto;width:100%}
@media(max-width:900px){.main{padding:72px 20px 40px}}
.section-page{display:none;animation:fadeUp .4s cubic-bezier(.22,1,.36,1)}
.section-page.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

/* Section header */
.sec-header{margin-bottom:36px}
.sec-number{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--emerald-600);margin-bottom:8px;display:flex;align-items:center;gap:8px}
.sec-number::after{content:'';flex:1;height:1px;background:var(--slate-200)}
.sec-title{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2rem);font-weight:800;color:var(--navy);line-height:1.2;margin-bottom:8px}
.sec-desc{font-size:.9rem;color:var(--slate-500);max-width:560px;line-height:1.6}

/* Form elements */
.field-group{margin-bottom:28px}
.field-row{display:grid;gap:20px;margin-bottom:28px}
.field-row.cols-2{grid-template-columns:1fr 1fr}
.field-row.cols-3{grid-template-columns:1fr 1fr 1fr}
@media(max-width:600px){.field-row.cols-2,.field-row.cols-3{grid-template-columns:1fr}}
label{display:block;font-size:.8rem;font-weight:600;color:var(--navy);margin-bottom:6px}
label .optional{font-weight:400;color:var(--slate-400);margin-left:4px}
label .hint{display:block;font-weight:400;font-size:.75rem;color:var(--slate-500);margin-top:2px;line-height:1.45}
input[type="text"],input[type="email"],input[type="tel"],input[type="url"],input[type="number"],select,textarea{
  width:100%;padding:11px 14px;font-size:.875rem;font-family:var(--font-body);color:var(--navy);
  border:1.5px solid var(--slate-200);border-radius:var(--radius-sm);background:var(--white);
  transition:border-color .2s,box-shadow .2s;outline:none;line-height:1.5
}
input:focus,select:focus,textarea:focus{border-color:var(--emerald-500);box-shadow:0 0 0 3px rgba(16,185,129,.1)}
textarea{min-height:100px;resize:vertical}
select{appearance:none;background-image:url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%2394A3B8' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");background-repeat:no-repeat;background-position:right 12px center;padding-right:36px}

/* Checkbox/Radio group */
.check-group{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
.check-item{position:relative}
.check-item input{position:absolute;opacity:0;pointer-events:none}
.check-item span{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;font-size:.8rem;font-weight:500;
  border:1.5px solid var(--slate-200);border-radius:var(--radius-sm);background:var(--white);
  cursor:pointer;transition:all .2s;user-select:none}
.check-item input:checked+span{border-color:var(--emerald-500);background:var(--emerald-50);color:var(--emerald-600);font-weight:600}
.check-item span:hover{border-color:var(--slate-300);background:var(--slate-50)}

/* Color swatch inputs */
.color-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:4px}
.color-slot{display:flex;align-items:center;gap:8px}
.color-slot input[type="color"]{width:38px;height:38px;border:2px solid var(--slate-200);border-radius:8px;padding:2px;cursor:pointer;background:none}
.color-slot input[type="text"]{width:90px;padding:8px 10px;font-size:.8rem;text-transform:uppercase;font-family:'Courier New',monospace}

/* File upload zone */
.upload-zone{border:2px dashed var(--slate-200);border-radius:var(--radius);padding:32px 20px;text-align:center;cursor:pointer;transition:all .2s}
.upload-zone:hover{border-color:var(--emerald-400);background:var(--emerald-50)}
.upload-zone p{font-size:.85rem;color:var(--slate-500)}.upload-zone .uc{color:var(--emerald-600);font-weight:600}
.upload-zone svg{width:32px;height:32px;color:var(--slate-300);margin:0 auto 10px}

/* Tip callout */
.tip{display:flex;gap:12px;padding:14px 18px;background:var(--emerald-50);border:1px solid var(--emerald-100);border-left:3px solid var(--emerald-500);border-radius:var(--radius-sm);margin:20px 0;font-size:.8rem;color:#065F46;line-height:1.55}
.tip svg{width:18px;height:18px;flex-shrink:0;margin-top:1px;color:var(--emerald-600)}
.warn{display:flex;gap:12px;padding:14px 18px;background:var(--amber-50);border:1px solid #FDE68A;border-left:3px solid var(--amber-500);border-radius:var(--radius-sm);margin:20px 0;font-size:.8rem;color:#92400E;line-height:1.55}

/* Scale slider */
.scale-row{display:flex;align-items:center;gap:16px;margin-top:8px}
.scale-row input[type="range"]{flex:1;accent-color:var(--emerald-500);height:6px}
.scale-labels{display:flex;justify-content:space-between;font-size:.7rem;color:var(--slate-400);margin-top:4px}

/* Navigation buttons */
.nav-buttons{display:flex;justify-content:space-between;align-items:center;padding-top:32px;border-top:1px solid var(--slate-100);margin-top:40px}
.btn-back{display:inline-flex;align-items:center;gap:6px;padding:12px 20px;font-size:.875rem;font-weight:600;color:var(--slate-500);background:none;border:1.5px solid var(--slate-200);border-radius:var(--radius-sm);transition:all .2s}
.btn-back:hover{color:var(--navy);border-color:var(--slate-300);background:var(--slate-50)}
.btn-next{display:inline-flex;align-items:center;gap:6px;padding:12px 24px;font-size:.875rem;font-weight:600;color:white;background:var(--emerald-500);border-radius:var(--radius-sm);transition:all .2s;box-shadow:0 4px 12px rgba(16,185,129,.2)}
.btn-next:hover{background:var(--emerald-600);box-shadow:0 6px 18px rgba(16,185,129,.3);transform:translateY(-1px)}
.btn-next:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
.btn-submit{background:var(--navy);box-shadow:0 4px 12px rgba(15,23,42,.2)}
.btn-submit:hover{background:var(--navy-800);box-shadow:0 6px 18px rgba(15,23,42,.3)}

/* Review section */
.review-block{background:var(--white);border:1px solid var(--slate-200);border-radius:var(--radius);margin-bottom:20px;overflow:hidden}
.review-block-header{padding:14px 20px;background:var(--slate-50);border-bottom:1px solid var(--slate-100);font-family:var(--font-display);font-weight:700;font-size:.95rem;display:flex;justify-content:space-between;align-items:center}
.review-block-header button{font-size:.75rem;font-weight:600;color:var(--emerald-600);background:none;border:none;cursor:pointer}
.review-block-header button:hover{text-decoration:underline}
.review-row{padding:10px 20px;display:flex;gap:12px;border-bottom:1px solid var(--slate-50);font-size:.84rem}
.review-row:last-child{border-bottom:none}
.review-label{width:160px;flex-shrink:0;font-weight:600;color:var(--slate-500);font-size:.78rem}
.review-value{color:var(--navy);flex:1;word-break:break-word}
.review-value.empty{color:var(--slate-300);font-style:italic}

/* Print styles */
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@media print{
  .sidebar,.mob-bar,.mob-overlay,.nav-buttons{display:none!important}
  .app-shell{grid-template-columns:1fr!important}
  .main{padding:20px!important;max-width:100%!important}
  .section-page{display:block!important;page-break-inside:avoid;animation:none!important}
  .review-block{break-inside:avoid}
  body{background:white}
}
</style>
</head>
<body>

<!-- Mobile topbar -->
<div class="mob-bar">
  <h2>Client Intake Form</h2>
  <button class="mob-btn" onclick="toggleSidebar()" aria-label="Menu"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg></button>
</div>
<div class="mob-overlay" id="mobOverlay" onclick="toggleSidebar()"></div>

<div class="app-shell">

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <h1>Website Build<br>Intake Form</h1>
      <p>Capture everything needed to design, build, and deploy a client website.</p>
    </div>
    <nav class="sidebar-nav" id="sidebarNav">
      <div class="nav-section-label">Discovery</div>
      <button class="nav-item active" data-section="0"><div class="nav-check"></div>Business Overview</button>
      <button class="nav-item" data-section="1"><div class="nav-check"></div>Brand Identity</button>
      <button class="nav-item" data-section="2"><div class="nav-check"></div>Target Audience</button>
      <div class="nav-section-label">Content</div>
      <button class="nav-item" data-section="3"><div class="nav-check"></div>Services & Offers</button>
      <button class="nav-item" data-section="4"><div class="nav-check"></div>Content & Messaging</button>
      <button class="nav-item" data-section="5"><div class="nav-check"></div>Social Proof</button>
      <div class="nav-section-label">Build</div>
      <button class="nav-item" data-section="6"><div class="nav-check"></div>Design Preferences</button>
      <button class="nav-item" data-section="7"><div class="nav-check"></div>Features & Functionality</button>
      <button class="nav-item" data-section="8"><div class="nav-check"></div>Technical & Hosting</button>
      <div class="nav-section-label">Finalize</div>
      <button class="nav-item" data-section="9"><div class="nav-check"></div>Timeline & Budget</button>
      <button class="nav-item" data-section="10"><div class="nav-check"></div>Review & Submit</button>
    </nav>
    <div class="sidebar-progress">
      <div class="progress-label"><span>Progress</span><span id="progressPct">0%</span></div>
      <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
    </div>
  </aside>

  <!-- ═══ MAIN CONTENT ═══ -->
  <main class="main">

    <!-- ── SECTION 0: Business Overview ── -->
    <div class="section-page active" data-index="0">
      <div class="sec-header">
        <div class="sec-number">Section 1 of 11</div>
        <h2 class="sec-title">Business Overview</h2>
        <p class="sec-desc">The basics. Who are you, what do you do, and where do you do it?</p>
      </div>
      <div class="field-row cols-2">
        <div><label>Business Name<span class="hint">Legal name or DBA</span></label><input type="text" id="f_biz_name" placeholder="e.g., WL Printing House"></div>
        <div><label>Owner / Point of Contact</label><input type="text" id="f_contact_name" placeholder="Full name"></div>
      </div>
      <div class="field-row cols-2">
        <div><label>Email</label><input type="email" id="f_email" placeholder="you@business.com"></div>
        <div><label>Phone</label><input type="tel" id="f_phone" placeholder="(555) 000-0000"></div>
      </div>
      <div class="field-row cols-2">
        <div><label>Physical Address<span class="optional">if applicable</span></label><input type="text" id="f_address" placeholder="Street, City, State, ZIP"></div>
        <div><label>Service Area</label><input type="text" id="f_service_area" placeholder="e.g., South Florida, Nationwide, Online Only"></div>
      </div>
      <div class="field-group">
        <label>Business Type</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="biz_type" value="Brick & Mortar"><span>Brick & Mortar</span></label>
          <label class="check-item"><input type="radio" name="biz_type" value="Online Only"><span>Online Only</span></label>
          <label class="check-item"><input type="radio" name="biz_type" value="Hybrid"><span>Hybrid (Both)</span></label>
          <label class="check-item"><input type="radio" name="biz_type" value="Service-Based"><span>Service-Based</span></label>
          <label class="check-item"><input type="radio" name="biz_type" value="E-Commerce"><span>E-Commerce</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Years in Business</label>
        <select id="f_years">
          <option value="">Select...</option>
          <option>Pre-launch / Startup</option><option>Less than 1 year</option><option>1 to 3 years</option>
          <option>3 to 5 years</option><option>5 to 10 years</option><option>10 to 20 years</option><option>20+ years</option>
        </select>
      </div>
      <div class="field-group">
        <label>Describe your business in 2 to 3 sentences.<span class="hint">The way you would explain it to someone at a barbecue. Plain English.</span></label>
        <textarea id="f_biz_desc" placeholder="We do [what] for [who]. Our customers come to us when they need [outcome]. What makes us different is [differentiator]."></textarea>
      </div>
      <div class="field-group">
        <label>Current Website URL<span class="optional">if you have one</span></label>
        <input type="url" id="f_current_url" placeholder="https://...">
      </div>
      <div class="nav-buttons"><div></div><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 1: Brand Identity ── -->
    <div class="section-page" data-index="1">
      <div class="sec-header">
        <div class="sec-number">Section 2 of 11</div>
        <h2 class="sec-title">Brand Identity & Voice</h2>
        <p class="sec-desc">Your brand is more than a logo. This is how we capture the personality behind the business.</p>
      </div>
      <div class="field-group">
        <label>Do you have an existing logo?</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="has_logo" value="Yes"><span>Yes, ready to use</span></label>
          <label class="check-item"><input type="radio" name="has_logo" value="Needs Update"><span>Yes, but needs updating</span></label>
          <label class="check-item"><input type="radio" name="has_logo" value="No"><span>No, need one designed</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Brand Colors<span class="hint">If you have established colors, enter them below. Otherwise we will develop a palette.</span></label>
        <div class="color-row">
          <div class="color-slot"><input type="color" id="f_color1" value="#0F172A"><input type="text" id="f_color1_hex" value="#0F172A" maxlength="7" placeholder="#000000"></div>
          <div class="color-slot"><input type="color" id="f_color2" value="#10B981"><input type="text" id="f_color2_hex" value="#10B981" maxlength="7" placeholder="#000000"></div>
          <div class="color-slot"><input type="color" id="f_color3" value="#FFFFFF"><input type="text" id="f_color3_hex" value="#FFFFFF" maxlength="7" placeholder="#000000"></div>
        </div>
      </div>
      <div class="field-group">
        <label>How would you describe your brand personality? Pick up to 3.<span class="hint">This shapes the tone of the website copy and design choices.</span></label>
        <div class="check-group">
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Professional"><span>Professional</span></label>
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Warm & Friendly"><span>Warm & Friendly</span></label>
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Bold & Confident"><span>Bold & Confident</span></label>
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Playful & Fun"><span>Playful & Fun</span></label>
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Minimalist & Clean"><span>Minimalist & Clean</span></label>
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Luxury & Premium"><span>Luxury & Premium</span></label>
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Community-Driven"><span>Community-Driven</span></label>
          <label class="check-item"><input type="checkbox" name="brand_tone" value="Technical & Expert"><span>Technical & Expert</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Brand Voice: Formality Scale</label>
        <div class="scale-row"><span style="font-size:.75rem;color:var(--slate-500)">Casual</span><input type="range" id="f_formality" min="1" max="5" value="3"><span style="font-size:.75rem;color:var(--slate-500)">Formal</span></div>
        <div class="scale-labels"><span>Neighborhood vibe</span><span>Balanced</span><span>Corporate tone</span></div>
      </div>
      <div class="field-group">
        <label>Is there a tagline or slogan?<span class="optional">if you have one</span></label>
        <input type="text" id="f_tagline" placeholder="e.g., Big Business Polish. Neighborhood Soul.">
      </div>
      <div class="field-group">
        <label>List 2 to 3 websites you admire.<span class="hint">These do not need to be in your industry. We want to understand what visual style and tone resonates with you.</span></label>
        <textarea id="f_inspo_sites" rows="3" placeholder="URL 1: https://... (what you like about it)&#10;URL 2: https://... (what you like about it)"></textarea>
      </div>
      <div class="field-group">
        <label>What should visitors feel when they land on your site?<span class="hint">One sentence. e.g., "That they are in professional hands but talking to a real person."</span></label>
        <input type="text" id="f_feel" placeholder="They should feel...">
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 2: Target Audience ── -->
    <div class="section-page" data-index="2">
      <div class="sec-header">
        <div class="sec-number">Section 3 of 11</div>
        <h2 class="sec-title">Target Audience</h2>
        <p class="sec-desc">Who is this site for? The more specific you are, the sharper the design and messaging.</p>
      </div>
      <div class="field-group">
        <label>Who is your primary customer?<span class="hint">Describe your ideal customer. Be specific. Age range, profession, lifestyle, location.</span></label>
        <textarea id="f_primary_audience" placeholder="e.g., Small business owners in Miami, ages 30 to 55, who need professional print materials but don't have an in-house designer."></textarea>
      </div>
      <div class="field-group">
        <label>Who is your secondary audience?<span class="optional">if applicable</span></label>
        <textarea id="f_secondary_audience" rows="3" placeholder="e.g., Brides planning weddings who want premium custom invitations."></textarea>
      </div>
      <div class="field-group">
        <label>What problem does your business solve for these people?</label>
        <textarea id="f_problem_solved" placeholder="e.g., They need high-quality print fast without the runaround. We offer same-day turnaround with personal service."></textarea>
      </div>
      <div class="field-group">
        <label>What objections do potential customers have before choosing you?<span class="hint">Price concerns, trust issues, not knowing you exist, switching from a competitor, etc.</span></label>
        <textarea id="f_objections" rows="3" placeholder="e.g., They think local print shops are more expensive than online services like Vistaprint."></textarea>
      </div>
      <div class="field-group">
        <label>How do customers currently find you?</label>
        <div class="check-group">
          <label class="check-item"><input type="checkbox" name="find_us" value="Google Search"><span>Google Search</span></label>
          <label class="check-item"><input type="checkbox" name="find_us" value="Social Media"><span>Social Media</span></label>
          <label class="check-item"><input type="checkbox" name="find_us" value="Word of Mouth"><span>Word of Mouth</span></label>
          <label class="check-item"><input type="checkbox" name="find_us" value="Walk-ins"><span>Walk-ins</span></label>
          <label class="check-item"><input type="checkbox" name="find_us" value="Referrals"><span>Referrals</span></label>
          <label class="check-item"><input type="checkbox" name="find_us" value="Advertising"><span>Advertising</span></label>
          <label class="check-item"><input type="checkbox" name="find_us" value="Not Sure"><span>Not Sure</span></label>
        </div>
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 3: Services & Offers ── -->
    <div class="section-page" data-index="3">
      <div class="sec-header">
        <div class="sec-number">Section 4 of 11</div>
        <h2 class="sec-title">Services & Offers</h2>
        <p class="sec-desc">What you sell and how you deliver it. This becomes the backbone of the site.</p>
      </div>
      <div class="field-group">
        <label>List your core services or products (up to 8).<span class="hint">Include a short description of each. These will become service cards, page sections, or menu items.</span></label>
        <textarea id="f_services_list" rows="8" placeholder="1. Digital Printing - Business cards, flyers, brochures. Same-day available.&#10;2. Shipping & Logistics - FedEx, UPS, USPS, DHL. Rate comparison.&#10;3. Large Format - Banners, posters, trade show displays.&#10;4. ..."></textarea>
      </div>
      <div class="field-group">
        <label>Do you have pricing you want displayed on the site?</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="show_pricing" value="Yes, specific prices"><span>Yes, specific prices</span></label>
          <label class="check-item"><input type="radio" name="show_pricing" value="Starting from ranges"><span>"Starting from" ranges</span></label>
          <label class="check-item"><input type="radio" name="show_pricing" value="Request a quote"><span>No, "Request a Quote" only</span></label>
          <label class="check-item"><input type="radio" name="show_pricing" value="Not sure yet"><span>Not sure yet</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>If showing pricing, list your key items and rates.<span class="optional">if applicable</span></label>
        <textarea id="f_pricing_detail" rows="4" placeholder="B&W copies: $0.08/page&#10;Color prints: $0.29/page&#10;Packing & shipping: $8.99/box"></textarea>
      </div>
      <div class="field-group">
        <label>What is your primary call-to-action?<span class="hint">The one thing you want every visitor to do.</span></label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="primary_cta" value="Call"><span>Call us</span></label>
          <label class="check-item"><input type="radio" name="primary_cta" value="Book"><span>Book an appointment</span></label>
          <label class="check-item"><input type="radio" name="primary_cta" value="Quote"><span>Request a quote</span></label>
          <label class="check-item"><input type="radio" name="primary_cta" value="Upload"><span>Upload a file</span></label>
          <label class="check-item"><input type="radio" name="primary_cta" value="Buy"><span>Buy online</span></label>
          <label class="check-item"><input type="radio" name="primary_cta" value="Visit"><span>Visit the store</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Business Hours</label>
        <textarea id="f_hours" rows="3" placeholder="Mon-Fri: 8 AM - 7 PM&#10;Saturday: 9 AM - 5 PM&#10;Sunday: Closed"></textarea>
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 4: Content & Messaging ── -->
    <div class="section-page" data-index="4">
      <div class="sec-header">
        <div class="sec-number">Section 5 of 11</div>
        <h2 class="sec-title">Content & Messaging</h2>
        <p class="sec-desc">The words on the page matter more than the design. This is where the brand voice becomes real.</p>
      </div>
      <div class="field-group">
        <label>What is your unique value proposition?<span class="hint">Finish this sentence: "People choose us over the competition because..."</span></label>
        <textarea id="f_uvp" placeholder="People choose us over the competition because..."></textarea>
      </div>
      <div class="field-group">
        <label>What are 3 to 5 key messages you want the site to communicate?<span class="hint">These become headlines, subheads, and talking points throughout the site.</span></label>
        <textarea id="f_key_messages" rows="5" placeholder="1. 20+ years of experience, locally owned&#10;2. Same-day turnaround on most orders&#10;3. We compare shipping rates to save you money&#10;4. Premium quality at neighborhood prices&#10;5. Walk-ins welcome, no appointment needed"></textarea>
      </div>
      <div class="field-group">
        <label>Do you have an "origin story" you want to share?<span class="hint">How the business started. Something personal. Customers connect with this.</span></label>
        <textarea id="f_origin_story" rows="4" placeholder="e.g., Started in a garage in 2005 with one printer and a dream..."></textarea>
      </div>
      <div class="field-group">
        <label>Are there specific phrases, words, or jargon you want to avoid?<span class="hint">Industry terms that confuse customers, or tones that feel off-brand.</span></label>
        <textarea id="f_avoid_words" rows="3" placeholder="e.g., Don't use 'synergy,' 'leverage,' or anything that sounds corporate. Keep it simple."></textarea>
      </div>
      <div class="field-group">
        <label>Do you have existing copy we should use or reference?<span class="hint">Brochures, old website text, ad copy, email templates, social media bios, etc.</span></label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="has_copy" value="Yes"><span>Yes, I will provide</span></label>
          <label class="check-item"><input type="radio" name="has_copy" value="Some"><span>Some, but need help</span></label>
          <label class="check-item"><input type="radio" name="has_copy" value="No"><span>No, write everything</span></label>
        </div>
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 5: Social Proof ── -->
    <div class="section-page" data-index="5">
      <div class="sec-header">
        <div class="sec-number">Section 6 of 11</div>
        <h2 class="sec-title">Social Proof & Trust Signals</h2>
        <p class="sec-desc">Testimonials, reviews, credentials, and anything else that builds trust at a glance.</p>
      </div>
      <div class="field-group">
        <label>Do you have customer testimonials or reviews?</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="has_testimonials" value="Yes"><span>Yes, I will provide</span></label>
          <label class="check-item"><input type="radio" name="has_testimonials" value="Google/Yelp"><span>On Google/Yelp</span></label>
          <label class="check-item"><input type="radio" name="has_testimonials" value="No"><span>Not yet</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Paste 2 to 4 testimonials below.<span class="optional">include name and title/role if available</span></label>
        <textarea id="f_testimonials" rows="6" placeholder="1. &quot;Quote here...&quot; - Name, Title&#10;2. &quot;Quote here...&quot; - Name, Title"></textarea>
      </div>
      <div class="field-group">
        <label>Trust signals and credentials. Check all that apply.</label>
        <div class="check-group">
          <label class="check-item"><input type="checkbox" name="trust" value="Licensed/Insured"><span>Licensed / Insured</span></label>
          <label class="check-item"><input type="checkbox" name="trust" value="Certifications"><span>Certifications</span></label>
          <label class="check-item"><input type="checkbox" name="trust" value="Awards"><span>Awards</span></label>
          <label class="check-item"><input type="checkbox" name="trust" value="Years in Business"><span>Years in Business</span></label>
          <label class="check-item"><input type="checkbox" name="trust" value="Media Features"><span>Media Features</span></label>
          <label class="check-item"><input type="checkbox" name="trust" value="Partner Logos"><span>Partner Logos</span></label>
          <label class="check-item"><input type="checkbox" name="trust" value="BBB Rating"><span>BBB Rating</span></label>
          <label class="check-item"><input type="checkbox" name="trust" value="Guarantees"><span>Guarantees</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Social media profiles to link from the site.</label>
        <div class="field-row cols-2" style="margin-bottom:0">
          <div><label style="font-size:.75rem">Facebook</label><input type="url" id="f_social_fb" placeholder="https://facebook.com/..."></div>
          <div><label style="font-size:.75rem">Instagram</label><input type="url" id="f_social_ig" placeholder="https://instagram.com/..."></div>
        </div>
        <div class="field-row cols-2" style="margin-top:12px">
          <div><label style="font-size:.75rem">LinkedIn</label><input type="url" id="f_social_li" placeholder="https://linkedin.com/in/..."></div>
          <div><label style="font-size:.75rem">Google Business</label><input type="url" id="f_social_google" placeholder="https://g.page/..."></div>
        </div>
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 6: Design Preferences ── -->
    <div class="section-page" data-index="6">
      <div class="sec-header">
        <div class="sec-number">Section 7 of 11</div>
        <h2 class="sec-title">Design Preferences</h2>
        <p class="sec-desc">Your visual taste. These choices shape layout, typography, and overall feel.</p>
      </div>
      <div class="field-group">
        <label>Preferred visual style. Pick up to 2.</label>
        <div class="check-group">
          <label class="check-item"><input type="checkbox" name="design_style" value="Clean & Modern"><span>Clean & Modern</span></label>
          <label class="check-item"><input type="checkbox" name="design_style" value="Bold & Dynamic"><span>Bold & Dynamic</span></label>
          <label class="check-item"><input type="checkbox" name="design_style" value="Warm & Organic"><span>Warm & Organic</span></label>
          <label class="check-item"><input type="checkbox" name="design_style" value="Minimal & Elegant"><span>Minimal & Elegant</span></label>
          <label class="check-item"><input type="checkbox" name="design_style" value="Dark & Premium"><span>Dark & Premium</span></label>
          <label class="check-item"><input type="checkbox" name="design_style" value="Playful & Colorful"><span>Playful & Colorful</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Site structure preference.</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="site_structure" value="Single Page"><span>Single Page (scroll)</span></label>
          <label class="check-item"><input type="radio" name="site_structure" value="Multi-Page"><span>Multi-Page (separate pages)</span></label>
          <label class="check-item"><input type="radio" name="site_structure" value="Not Sure"><span>Not sure, advise me</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Estimated number of pages or sections.</label>
        <select id="f_page_count">
          <option value="">Select...</option>
          <option>1 (single-page site)</option><option>2 to 5 pages</option><option>5 to 10 pages</option><option>10+ pages</option>
        </select>
      </div>
      <div class="field-group">
        <label>Do you have professional photos or images ready?</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="has_photos" value="Yes"><span>Yes, ready to use</span></label>
          <label class="check-item"><input type="radio" name="has_photos" value="Some"><span>Some, need more</span></label>
          <label class="check-item"><input type="radio" name="has_photos" value="No"><span>No, need stock photos</span></label>
          <label class="check-item"><input type="radio" name="has_photos" value="Need Shoot"><span>Need a photo shoot</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Anything specific you want to avoid in the design?</label>
        <textarea id="f_design_avoid" rows="3" placeholder="e.g., No stock photos of people shaking hands. No clip art. No blue and yellow color scheme."></textarea>
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 7: Features ── -->
    <div class="section-page" data-index="7">
      <div class="sec-header">
        <div class="sec-number">Section 8 of 11</div>
        <h2 class="sec-title">Features & Functionality</h2>
        <p class="sec-desc">What do you need the site to do? Check everything that applies.</p>
      </div>
      <div class="field-group">
        <label>Core features needed.</label>
        <div class="check-group">
          <label class="check-item"><input type="checkbox" name="features" value="Contact Form"><span>Contact Form</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Chatbot"><span>AI Chatbot</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="File Upload"><span>File Upload</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Booking/Scheduling"><span>Booking / Scheduling</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Online Payments"><span>Online Payments</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="E-Commerce"><span>E-Commerce / Cart</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Newsletter Signup"><span>Newsletter Signup</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Blog"><span>Blog</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Photo Gallery"><span>Photo Gallery</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Google Maps"><span>Google Maps</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Reviews Widget"><span>Reviews Widget</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="FAQ Section"><span>FAQ Section</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Video Embed"><span>Video Embed</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Calculator/Tool"><span>Calculator / Tool</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Member Login"><span>Member Login Area</span></label>
          <label class="check-item"><input type="checkbox" name="features" value="Multi-Language"><span>Multi-Language</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Chatbot details.<span class="optional">if chatbot was selected above</span><span class="hint">Describe the types of questions the chatbot should handle, and what it should guide visitors toward.</span></label>
        <textarea id="f_chatbot_detail" rows="4" placeholder="e.g., The chatbot should help visitors choose a service, provide pricing info, guide them to upload a file, and offer contact details. Personality should be friendly and knowledgeable."></textarea>
      </div>
      <div class="field-group">
        <label>Third-party integrations needed.<span class="optional">if any</span></label>
        <div class="check-group">
          <label class="check-item"><input type="checkbox" name="integrations" value="Google Analytics"><span>Google Analytics</span></label>
          <label class="check-item"><input type="checkbox" name="integrations" value="Facebook Pixel"><span>Facebook Pixel</span></label>
          <label class="check-item"><input type="checkbox" name="integrations" value="Mailchimp"><span>Mailchimp</span></label>
          <label class="check-item"><input type="checkbox" name="integrations" value="Calendly"><span>Calendly</span></label>
          <label class="check-item"><input type="checkbox" name="integrations" value="Square/Stripe"><span>Square / Stripe</span></label>
          <label class="check-item"><input type="checkbox" name="integrations" value="CRM"><span>CRM (HubSpot, etc.)</span></label>
          <label class="check-item"><input type="checkbox" name="integrations" value="Other"><span>Other (specify below)</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Other integration details.<span class="optional">if applicable</span></label>
        <input type="text" id="f_integrations_other" placeholder="e.g., Zapier, custom API, specific CRM name...">
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 8: Technical & Hosting ── -->
    <div class="section-page" data-index="8">
      <div class="sec-header">
        <div class="sec-number">Section 9 of 11</div>
        <h2 class="sec-title">Technical & Hosting</h2>
        <p class="sec-desc">Where the site lives and how it gets found.</p>
      </div>
      <div class="field-group">
        <label>Do you own a domain name?</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="has_domain" value="Yes"><span>Yes</span></label>
          <label class="check-item"><input type="radio" name="has_domain" value="No"><span>No, need one</span></label>
        </div>
      </div>
      <div class="field-row cols-2">
        <div><label>Domain name<span class="optional">if you have one</span></label><input type="text" id="f_domain" placeholder="e.g., wlprintinghouse.com"></div>
        <div><label>Domain registrar</label><input type="text" id="f_registrar" placeholder="e.g., GoDaddy, Namecheap, Google Domains"></div>
      </div>
      <div class="field-group">
        <label>Current or preferred hosting platform.</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="hosting" value="GoDaddy"><span>GoDaddy</span></label>
          <label class="check-item"><input type="radio" name="hosting" value="Wix"><span>Wix</span></label>
          <label class="check-item"><input type="radio" name="hosting" value="Squarespace"><span>Squarespace</span></label>
          <label class="check-item"><input type="radio" name="hosting" value="WordPress"><span>WordPress</span></label>
          <label class="check-item"><input type="radio" name="hosting" value="Shopify"><span>Shopify</span></label>
          <label class="check-item"><input type="radio" name="hosting" value="Netlify/Vercel"><span>Netlify / Vercel</span></label>
          <label class="check-item"><input type="radio" name="hosting" value="No Preference"><span>No preference</span></label>
          <label class="check-item"><input type="radio" name="hosting" value="Other"><span>Other</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Do you have existing email through your domain?<span class="hint">e.g., info@yourbusiness.com</span></label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="has_email" value="Yes"><span>Yes</span></label>
          <label class="check-item"><input type="radio" name="has_email" value="No"><span>No, need to set up</span></label>
          <label class="check-item"><input type="radio" name="has_email" value="Gmail"><span>Using Gmail / other</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>SEO priority level.</label>
        <div class="scale-row"><span style="font-size:.75rem;color:var(--slate-500)">Low</span><input type="range" id="f_seo_priority" min="1" max="5" value="3"><span style="font-size:.75rem;color:var(--slate-500)">High</span></div>
        <div class="scale-labels"><span>Not important right now</span><span>Nice to have</span><span>Must rank on Google</span></div>
      </div>
      <div class="field-group">
        <label>Any compliance or legal requirements?<span class="hint">Industry disclosures, ADA accessibility, HIPAA, financial regulations, etc.</span></label>
        <textarea id="f_compliance" rows="3" placeholder="e.g., Must include SEC/FINRA disclosures. Must be ADA compliant. No specific requirements."></textarea>
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 9: Timeline & Budget ── -->
    <div class="section-page" data-index="9">
      <div class="sec-header">
        <div class="sec-number">Section 10 of 11</div>
        <h2 class="sec-title">Timeline & Budget</h2>
        <p class="sec-desc">Setting expectations up front so there are no surprises on either side.</p>
      </div>
      <div class="field-group">
        <label>When do you need the site live?</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="timeline" value="ASAP"><span>ASAP (1 to 2 weeks)</span></label>
          <label class="check-item"><input type="radio" name="timeline" value="30 Days"><span>Within 30 days</span></label>
          <label class="check-item"><input type="radio" name="timeline" value="60 Days"><span>Within 60 days</span></label>
          <label class="check-item"><input type="radio" name="timeline" value="Flexible"><span>Flexible, no rush</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Is there a specific event or launch date driving the timeline?<span class="optional">if applicable</span></label>
        <input type="text" id="f_launch_event" placeholder="e.g., Grand opening March 15, Trade show April 1">
      </div>
      <div class="field-group">
        <label>Budget range for the website build.</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="budget" value="Under $1,000"><span>Under $1,000</span></label>
          <label class="check-item"><input type="radio" name="budget" value="$1,000 - $3,000"><span>$1,000 to $3,000</span></label>
          <label class="check-item"><input type="radio" name="budget" value="$3,000 - $5,000"><span>$3,000 to $5,000</span></label>
          <label class="check-item"><input type="radio" name="budget" value="$5,000 - $10,000"><span>$5,000 to $10,000</span></label>
          <label class="check-item"><input type="radio" name="budget" value="$10,000+"><span>$10,000+</span></label>
          <label class="check-item"><input type="radio" name="budget" value="Discuss"><span>Let's discuss</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Do you need ongoing maintenance after launch?</label>
        <div class="check-group">
          <label class="check-item"><input type="radio" name="maintenance" value="Yes"><span>Yes, monthly retainer</span></label>
          <label class="check-item"><input type="radio" name="maintenance" value="As Needed"><span>As needed</span></label>
          <label class="check-item"><input type="radio" name="maintenance" value="Self"><span>I will manage it</span></label>
          <label class="check-item"><input type="radio" name="maintenance" value="Not Sure"><span>Not sure yet</span></label>
        </div>
      </div>
      <div class="field-group">
        <label>Anything else we should know?<span class="hint">Special requests, pet peeves, past experiences with web developers, anything at all.</span></label>
        <textarea id="f_additional_notes" rows="4" placeholder="Speak your mind. This is the open floor."></textarea>
      </div>
      <div class="nav-buttons"><button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button><button class="btn-next" onclick="goNext()">Continue to Review <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></button></div>
    </div>

    <!-- ── SECTION 10: Review & Submit ── -->
    <div class="section-page" data-index="10">
      <div class="sec-header">
        <div class="sec-number">Section 11 of 11</div>
        <h2 class="sec-title">Review & Submit</h2>
        <p class="sec-desc">Review your responses below. Click "Edit" on any section to go back and make changes.</p>
      </div>
      <div id="reviewContainer"></div>
      <div class="tip"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><div>You do not need to fill every field. Complete what you know now. We will work through the rest together during the discovery call.</div></div>
      <div class="nav-buttons">
        <button class="btn-back" onclick="goPrev()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg> Back</button>
        <div style="display:flex;gap:12px">
          <button class="btn-back" onclick="printForm()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg> Print / Save PDF</button>
          <button class="btn-next btn-submit" onclick="submitForm()"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Submit Intake</button>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
// ── State ──
let currentSection = 0;
const totalSections = 11;
const completedSections = new Set();

// ── Navigation ──
function goTo(idx) {
  if (idx === currentSection) return;
  // Mark current as completed
  if (idx > currentSection) completedSections.add(currentSection);
  currentSection = idx;
  // Update pages
  document.querySelectorAll('.section-page').forEach(p => p.classList.remove('active'));
  document.querySelector(`.section-page[data-index="${idx}"]`).classList.add('active');
  // Update nav
  document.querySelectorAll('.nav-item').forEach(n => {
    const s = parseInt(n.dataset.section);
    n.classList.toggle('active', s === idx);
    n.classList.toggle('completed', completedSections.has(s));
  });
  // Build review if on last page
  if (idx === 10) buildReview();
  updateProgress();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  // Close mobile sidebar
  document.getElementById('sidebar').classList.remove('open');
  document.getElementById('mobOverlay').classList.remove('open');
}
function goNext() { if (currentSection < totalSections - 1) goTo(currentSection + 1); }
function goPrev() { if (currentSection > 0) goTo(currentSection - 1); }

// Sidebar nav clicks
document.querySelectorAll('.nav-item').forEach(btn => {
  btn.addEventListener('click', () => goTo(parseInt(btn.dataset.section)));
});

function updateProgress() {
  const pct = Math.round((completedSections.size / (totalSections - 1)) * 100);
  document.getElementById('progressPct').textContent = pct + '%';
  document.getElementById('progressFill').style.width = pct + '%';
}

// Mobile sidebar
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('mobOverlay').classList.toggle('open');
}

// Color pickers sync
document.querySelectorAll('.color-slot').forEach(slot => {
  const picker = slot.querySelector('input[type="color"]');
  const text = slot.querySelector('input[type="text"]');
  picker.addEventListener('input', () => { text.value = picker.value.toUpperCase(); });
  text.addEventListener('input', () => { if (/^#[0-9A-Fa-f]{6}$/.test(text.value)) picker.value = text.value; });
});

// ── Build Review ──
function getVal(id) { const el = document.getElementById(id); return el ? el.value.trim() : ''; }
function getRadio(name) { const el = document.querySelector(`input[name="${name}"]:checked`); return el ? el.value : ''; }
function getChecked(name) { return Array.from(document.querySelectorAll(`input[name="${name}"]:checked`)).map(c => c.value).join(', '); }

function buildReview() {
  const sections = [
    { title: 'Business Overview', idx: 0, fields: [
      ['Business Name', getVal('f_biz_name')], ['Contact', getVal('f_contact_name')],
      ['Email', getVal('f_email')], ['Phone', getVal('f_phone')],
      ['Address', getVal('f_address')], ['Service Area', getVal('f_service_area')],
      ['Business Type', getRadio('biz_type')], ['Years in Business', getVal('f_years')],
      ['Description', getVal('f_biz_desc')], ['Current URL', getVal('f_current_url')]
    ]},
    { title: 'Brand Identity', idx: 1, fields: [
      ['Logo Status', getRadio('has_logo')],
      ['Brand Colors', [getVal('f_color1_hex'), getVal('f_color2_hex'), getVal('f_color3_hex')].filter(c => c && c !== '#FFFFFF').join(', ')],
      ['Brand Personality', getChecked('brand_tone')],
      ['Formality (1-5)', document.getElementById('f_formality').value],
      ['Tagline', getVal('f_tagline')],
      ['Inspiration Sites', getVal('f_inspo_sites')],
      ['Desired Feeling', getVal('f_feel')]
    ]},
    { title: 'Target Audience', idx: 2, fields: [
      ['Primary Audience', getVal('f_primary_audience')],
      ['Secondary Audience', getVal('f_secondary_audience')],
      ['Problem Solved', getVal('f_problem_solved')],
      ['Common Objections', getVal('f_objections')],
      ['Discovery Channels', getChecked('find_us')]
    ]},
    { title: 'Services & Offers', idx: 3, fields: [
      ['Services List', getVal('f_services_list')],
      ['Pricing Display', getRadio('show_pricing')],
      ['Pricing Details', getVal('f_pricing_detail')],
      ['Primary CTA', getRadio('primary_cta')],
      ['Business Hours', getVal('f_hours')]
    ]},
    { title: 'Content & Messaging', idx: 4, fields: [
      ['Value Proposition', getVal('f_uvp')],
      ['Key Messages', getVal('f_key_messages')],
      ['Origin Story', getVal('f_origin_story')],
      ['Words to Avoid', getVal('f_avoid_words')],
      ['Existing Copy', getRadio('has_copy')]
    ]},
    { title: 'Social Proof', idx: 5, fields: [
      ['Testimonials Status', getRadio('has_testimonials')],
      ['Testimonials', getVal('f_testimonials')],
      ['Trust Signals', getChecked('trust')],
      ['Facebook', getVal('f_social_fb')], ['Instagram', getVal('f_social_ig')],
      ['LinkedIn', getVal('f_social_li')], ['Google', getVal('f_social_google')]
    ]},
    { title: 'Design Preferences', idx: 6, fields: [
      ['Visual Style', getChecked('design_style')],
      ['Site Structure', getRadio('site_structure')],
      ['Page Count', getVal('f_page_count')],
      ['Photos Ready', getRadio('has_photos')],
      ['Design Avoid', getVal('f_design_avoid')]
    ]},
    { title: 'Features & Functionality', idx: 7, fields: [
      ['Core Features', getChecked('features')],
      ['Chatbot Details', getVal('f_chatbot_detail')],
      ['Integrations', getChecked('integrations')],
      ['Other Integrations', getVal('f_integrations_other')]
    ]},
    { title: 'Technical & Hosting', idx: 8, fields: [
      ['Has Domain', getRadio('has_domain')],
      ['Domain', getVal('f_domain')], ['Registrar', getVal('f_registrar')],
      ['Hosting Platform', getRadio('hosting')],
      ['Business Email', getRadio('has_email')],
      ['SEO Priority (1-5)', document.getElementById('f_seo_priority').value],
      ['Compliance', getVal('f_compliance')]
    ]},
    { title: 'Timeline & Budget', idx: 9, fields: [
      ['Timeline', getRadio('timeline')],
      ['Launch Event', getVal('f_launch_event')],
      ['Budget', getRadio('budget')],
      ['Maintenance', getRadio('maintenance')],
      ['Additional Notes', getVal('f_additional_notes')]
    ]}
  ];

  const container = document.getElementById('reviewContainer');
  container.innerHTML = '';
  sections.forEach(sec => {
    let html = `<div class="review-block"><div class="review-block-header">${sec.title}<button onclick="goTo(${sec.idx})">Edit</button></div>`;
    sec.fields.forEach(([label, val]) => {
      const display = val || '';
      const cls = display ? '' : ' empty';
      html += `<div class="review-row"><div class="review-label">${label}</div><div class="review-value${cls}">${display || 'Not provided'}</div></div>`;
    });
    html += '</div>';
    container.innerHTML += html;
  });
}

function printForm() {
  buildReview();
  // Show all sections for print
  document.querySelectorAll('.section-page').forEach(p => p.classList.add('active'));
  // Only show review
  setTimeout(() => {
    document.querySelectorAll('.section-page').forEach(p => {
      if (p.dataset.index !== '10') p.classList.remove('active');
    });
    window.print();
  }, 100);
}

// ═══════════════════════════════════════════════════════════
//  EMAIL CONFIGURATION — Edit these two values
// ═══════════════════════════════════════════════════════════
const EMAIL_CONFIG = {
  // Step 1: Go to https://web3forms.com and enter your email
  // Step 2: They email you an access key instantly (free)
  // Step 3: Paste it below between the quotes
  accessKey: '5cdee561-dfd2-4c98-899a-b0457070cc5a',

  // The email subject line for submitted forms
  subject: 'New Website Build Intake Form Submitted'
};
// ═══════════════════════════════════════════════════════════

function collectAllData() {
  const data = {};
  data['Business Name'] = getVal('f_biz_name');
  data['Contact Name'] = getVal('f_contact_name');
  data['Email'] = getVal('f_email');
  data['Phone'] = getVal('f_phone');
  data['Address'] = getVal('f_address');
  data['Service Area'] = getVal('f_service_area');
  data['Business Type'] = getRadio('biz_type');
  data['Years in Business'] = getVal('f_years');
  data['Business Description'] = getVal('f_biz_desc');
  data['Current URL'] = getVal('f_current_url');
  data['Logo Status'] = getRadio('has_logo');
  data['Brand Colors'] = [getVal('f_color1_hex'), getVal('f_color2_hex'), getVal('f_color3_hex')].filter(c => c && c !== '#FFFFFF').join(', ');
  data['Brand Personality'] = getChecked('brand_tone');
  data['Formality Scale (1-5)'] = document.getElementById('f_formality').value;
  data['Tagline'] = getVal('f_tagline');
  data['Inspiration Sites'] = getVal('f_inspo_sites');
  data['Desired Feeling'] = getVal('f_feel');
  data['Primary Audience'] = getVal('f_primary_audience');
  data['Secondary Audience'] = getVal('f_secondary_audience');
  data['Problem Solved'] = getVal('f_problem_solved');
  data['Common Objections'] = getVal('f_objections');
  data['Discovery Channels'] = getChecked('find_us');
  data['Services List'] = getVal('f_services_list');
  data['Pricing Display'] = getRadio('show_pricing');
  data['Pricing Details'] = getVal('f_pricing_detail');
  data['Primary CTA'] = getRadio('primary_cta');
  data['Business Hours'] = getVal('f_hours');
  data['Value Proposition'] = getVal('f_uvp');
  data['Key Messages'] = getVal('f_key_messages');
  data['Origin Story'] = getVal('f_origin_story');
  data['Words to Avoid'] = getVal('f_avoid_words');
  data['Existing Copy'] = getRadio('has_copy');
  data['Testimonials Status'] = getRadio('has_testimonials');
  data['Testimonials'] = getVal('f_testimonials');
  data['Trust Signals'] = getChecked('trust');
  data['Facebook'] = getVal('f_social_fb');
  data['Instagram'] = getVal('f_social_ig');
  data['LinkedIn'] = getVal('f_social_li');
  data['Google Business'] = getVal('f_social_google');
  data['Visual Style'] = getChecked('design_style');
  data['Site Structure'] = getRadio('site_structure');
  data['Page Count'] = getVal('f_page_count');
  data['Photos Ready'] = getRadio('has_photos');
  data['Design Avoid'] = getVal('f_design_avoid');
  data['Core Features'] = getChecked('features');
  data['Chatbot Details'] = getVal('f_chatbot_detail');
  data['Integrations'] = getChecked('integrations');
  data['Other Integrations'] = getVal('f_integrations_other');
  data['Has Domain'] = getRadio('has_domain');
  data['Domain Name'] = getVal('f_domain');
  data['Registrar'] = getVal('f_registrar');
  data['Hosting Platform'] = getRadio('hosting');
  data['Business Email'] = getRadio('has_email');
  data['SEO Priority (1-5)'] = document.getElementById('f_seo_priority').value;
  data['Compliance'] = getVal('f_compliance');
  data['Timeline'] = getRadio('timeline');
  data['Launch Event'] = getVal('f_launch_event');
  data['Budget'] = getRadio('budget');
  data['Maintenance'] = getRadio('maintenance');
  data['Additional Notes'] = getVal('f_additional_notes');
  return data;
}

function showToast(message, type) {
  const existing = document.getElementById('toast');
  if (existing) existing.remove();
  const toast = document.createElement('div');
  toast.id = 'toast';
  const bg = type === 'success' ? '#059669' : '#EF4444';
  toast.style.cssText = 'position:fixed;bottom:24px;right:24px;left:24px;max-width:480px;margin:0 auto;padding:16px 20px;background:'+bg+';color:white;font-family:var(--font-body);font-size:.875rem;font-weight:500;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:9999;animation:fadeUp .3s ease';
  toast.textContent = message;
  document.body.appendChild(toast);
  setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity .3s'; setTimeout(() => toast.remove(), 300); }, 5000);
}

async function submitForm() {
  buildReview();
  const submitBtn = document.querySelector('.btn-submit');
  const originalHTML = submitBtn.innerHTML;
  const data = collectAllData();

  // Fallback if Web3Forms not configured
  if (EMAIL_CONFIG.accessKey === 'YOUR_ACCESS_KEY_HERE') {
    const body = Object.entries(data).filter(([k,v]) => v).map(([k,v]) => k + ':\n' + v).join('\n\n---\n\n');
    const mailto = 'mailto:?subject=' + encodeURIComponent(EMAIL_CONFIG.subject) + '&body=' + encodeURIComponent(body);
    window.open(mailto, '_blank');
    showToast('Web3Forms access key not configured. Your email client opened as a fallback. See setup instructions in the HTML file.', 'error');
    return;
  }

  // Loading state
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<svg width="16" height="16" style="animation:spin .6s linear infinite" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Sending...';

  // Build formatted message
  const sections = ['Business Overview','Brand Identity','Target Audience','Services & Offers','Content & Messaging','Social Proof','Design Preferences','Features & Functionality','Technical & Hosting','Timeline & Budget'];
  const bounds = [0,10,17,22,27,32,39,44,48,55];
  let msg = 'WEBSITE BUILD INTAKE FORM\nSubmitted: ' + new Date().toLocaleString() + '\n';
  msg += '='.repeat(50) + '\n\n';
  let secIdx = -1;
  Object.entries(data).forEach(([key, val], idx) => {
    const newSec = bounds.findIndex((b,i) => idx >= b && (i === bounds.length - 1 || idx < bounds[i+1]));
    if (newSec !== secIdx) { secIdx = newSec; msg += '\n--- ' + (sections[secIdx] || '') + ' ---\n\n'; }
    if (val) msg += key + ': ' + val + '\n';
  });

  try {
    const response = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        access_key: EMAIL_CONFIG.accessKey,
        subject: EMAIL_CONFIG.subject + (data['Business Name'] ? ' — ' + data['Business Name'] : ''),
        from_name: data['Contact Name'] || data['Business Name'] || 'Intake Form',
        replyto: data['Email'] || '',
        message: msg
      })
    });
    const result = await response.json();
    if (result.success) {
      submitBtn.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Sent!';
      submitBtn.style.background = '#059669';
      showToast('Form submitted. A copy has been emailed to your inbox.', 'success');
      setTimeout(() => { submitBtn.innerHTML = originalHTML; submitBtn.style.background = ''; submitBtn.disabled = false; }, 4000);
    } else {
      throw new Error(result.message || 'Delivery failed');
    }
  } catch (err) {
    submitBtn.innerHTML = originalHTML;
    submitBtn.disabled = false;
    showToast('Email failed: ' + err.message + '. Check your access key.', 'error');
  }
}
</script>
</body>
</html>
